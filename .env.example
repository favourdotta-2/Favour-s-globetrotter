# Generate a random key of at least 32 characters before starting user or monolith.
SECRET_KEY=
# Public browser origin. Initialize-Local.ps1 uses localhost for local development.
# The hosted Compose override enforces this origin even if an existing .env is local.
FRONTEND_ORIGIN=https://dotta-globe.duckdns.org
# Public search is for small, single-worker deployments; see the Nominatim policy in README.
GEOCODING_URL=https://nominatim.openstreetmap.org/search
GEOCODING_USER_AGENT=GlobeTrotterCameroon/1.0 (https://github.com/favourdotta-2/Favour-s-globetrotter)
# Public OSRM is only for the small local demo; use a self-hosted provider for production.
ROUTING_URL=https://router.project-osrm.org/route/v1/driving
ROUTING_USER_AGENT=GlobeTrotterCameroon/1.0 (https://github.com/favourdotta-2/Favour-s-globetrotter)
